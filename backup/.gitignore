# DAC6 Backup - Gitignore
# Estos archivos son muy grandes y no deben subirse a git

# Python installer (~25 MB)
python/*.exe

# PyTorch wheels (~2.3 GB)
pytorch/*.whl

# DAC model weights (~880 MB)
dac/*.pth

# ffmpeg (~80 MB)
ffmpeg/*.zip

# Pip packages (~200 MB)
pip_packages/*.whl
pip_packages/*.tar.gz

# Scripts generados
scripts/*.bat

# Pero SÍ incluye los READMEs y guías
!BACKUP_README.txt
!HOW_TO_HOST.txt
!.gitignore
